{
  "name": "reelsmith-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Reelsmith blog admin dashboard (Next.js + MongoDB). Runs at /admin.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "import-content": "node scripts/import-content.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sanitize-html": "2.18.1"
  },
  "type": "module",
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "wrangler": "^4.153.0"
  }
}
