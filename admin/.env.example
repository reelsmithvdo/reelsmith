# Example settings for the Reelsmith admin: copy to .env.local and fill in. (.env.local is never committed.)
MONGODB_URI=
MONGODB_DB=reelsmith
ADMIN_EMAIL=reelsmith.vdo@gmail.com
# Create with: node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "your password"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Google (Search Console + Analytics) service account key (kept outside the repo)
GOOGLE_KEY_FILE=
GSC_SITE=sc-domain:reelsmithapp.com
GA_PROPERTY_ID=563309476
SITE_URL=https://reelsmithapp.com
# The website folder the publish step writes into
SITE_SRC=../src
