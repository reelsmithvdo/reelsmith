// Cloudflare Workers config for the Reelsmith website (deployed automatically on every push to main).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reelsmith",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The editor itself: plain static files, served free and without limits by Cloudflare.
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Browser page visits to unknown paths would otherwise get the 404 page without reaching the Worker.
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "vars": {
    // Bug reports / feature requests become issues here. Make this repository PRIVATE
    // (reports can contain email addresses). Add the GITHUB_TOKEN secret in the dashboard.
    "FEEDBACK_REPO": "reelsmithvdo/reelsmith-feedback"
  },
  // Custom domain (bought through Cloudflare). www → root is a Redirect Rule in the dashboard,
  // so static files stay free (routing them through the Worker would count against its quota).
  "routes": [{ "pattern": "reelsmithapp.com", "custom_domain": true }],
  // Hourly scheduled publish (free Cron Trigger).
  // The blog admin Worker (admin/wrangler.jsonc), reached at /admin through this binding.
  "services": [{ "binding": "ADMIN", "service": "reelsmith-admin" }],
  "triggers": { "crons": ["17 * * * *"] },
  // Rebuild the static pages from content/posts.json (written by the admin's Publish site) on every deploy.
  "build": { "command": "node scripts/build-site.js" },
  "observability": { "enabled": true }
}
